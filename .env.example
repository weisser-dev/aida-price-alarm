# Server
PORT=3000
APP_BASE_URL=http://localhost:3000

# Database
DATABASE_PATH=./data/aida.db

# Scraper
# Cron expression for the daily fetch run (default: 06:15 every day)
SCRAPE_CRON=15 6 * * *
# When true, the scraper uses bundled demo data instead of hitting AIDA.
# Useful for first start, CI and development.
USE_MOCK=true
# Endpoint of the AIDA cruise search (only used when USE_MOCK=false).
# This must be verified against the live site - the structure of the response
# is parsed in src/services/aidaAdapter.js and may need to be adjusted.
AIDA_API_URL=
AIDA_USER_AGENT=Mozilla/5.0 (compatible; AidaPriceTracker/1.0; +https://example.com)

# SMTP for notifications. Leave empty to log mails to stdout instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AIDA Preisalarm <noreply@example.com>"
