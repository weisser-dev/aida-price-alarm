# Diese Datei ist nur die Vorlage. Im Betrieb setzt der Deploy-Workflow
# alle Werte als Umgebungsvariablen; für lokale Tests kann man sie kopieren:
#   cp .env.example .env && docker compose up --build

# --- Server -----------------------------------------------------------------
APP_PORT=3000
APP_BASE_URL=https://aida.weisser.dev
TZ=Europe/Berlin

# --- Messtakt ---------------------------------------------------------------
# Alle vier Stunden zur Minute 07: 00:07, 04:07, 08:07, 12:07, 16:07, 20:07.
# Leer lassen schaltet den Zeitplan ab — dann misst nur noch der Knopf.
LAUF_INTERVALL_STUNDEN=4
LAUF_OFFSET_MINUTEN=7
# Mindestabstand zwischen zwei Abrufen derselben Reise, in Sekunden.
# Schützt die fremde Buchungsstrecke. Bitte nicht auf 0 setzen.
MINDESTABSTAND_SEKUNDEN=60

# --- Meldewege --------------------------------------------------------------
# Alles leer = nur Protokoll und Oberfläche, keine Benachrichtigung.

# E-Mail (im Betrieb aus den GitHub-Secrets SMTP_USER / SMTP_PASS / MAIL_AN)
MAIL_AN=
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Strato verlangt: Absender == angemeldeter Benutzer
SMTP_FROM=

# ntfy (optional, zusätzlich): eigenes Thema wählen und in der App abonnieren
NTFY_URL=
NTFY_TOKEN=

# --- Sonstiges --------------------------------------------------------------
# Weitere erlaubte Hostnamen, kommagetrennt. APP_BASE_URL wird automatisch
# ergänzt; das hier braucht man nur bei mehreren Domains.
AIDA_ALLOWED_HOSTS=
