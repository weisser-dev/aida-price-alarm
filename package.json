{
  "name": "aida-price-alarm",
  "version": "0.1.0",
  "private": true,
  "description": "Tracks AIDA cruise prices daily and notifies users by email when prices drop or new fares appear.",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
